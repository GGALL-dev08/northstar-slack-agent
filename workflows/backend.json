      "id": "outbox_outbox_7",
      "name": "Outbox · Build Slack review blocks + copyable text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        1500
      ],
      "parameters": {
        "jsCode": "function reviewCard(d) {\n const clip=String(d.body||'').replace(/```/g,'` ` `');const value=JSON.stringify({draft_id:d.draft_id,revision_hash:d.revision_hash});\n const eligible=d.verification?.passed===true && d.status!=='blocked';\n const actions=[{type:'button',text:{type:'plain_text',text:'Save document'},action_id:'save_asset',value}];\n if(eligible)actions.push({type:'button',text:{type:'plain_text',text:'Approve this revision for sending'},action_id:'approve_send',value,confirm:{title:{type:'plain_text',text:'Send this revision?'},text:{type:'mrkdwn',text:'Confirm the destination and content before sending.'},confirm:{type:'plain_text',text:'Confirm'},deny:{type:'plain_text',text:'Cancel'}}});\n return {text:'Draft ready for review',copy_text:d.body,text_attachment:{filename:d.draft_id+'.txt',content:d.body},blocks:[{type:'header',text:{type:'plain_text',text:'Northstar Relay · review draft'}},{type:'section',text:{type:'mrkdwn',text:(eligible?'Model checks passed; human review required.':'UNVERIFIED / FIXTURE — sending blocked.')+'\\nMedium: '+d.channel}},{type:'section',text:{type:'mrkdwn',text:'```'+clip.slice(0,2800)+'```'}},{type:'context',elements:[{type:'mrkdwn',text:'Draft '+d.draft_id+' · revision '+d.revision_hash.slice(0,12)+' · full text attached when adapter connected. Use the code-block copy control where your Slack client supports it.'}]},{type:'actions',elements:actions}],draft_id:d.draft_id,revision_hash:d.revision_hash,dispatch_allowed:false};\n}\nreturn $input.all().map(i=>({json:{...reviewCard(i.json.data),draft:i.json.data,status:'held',delivered:false,reason:'Connect and verify Slack/folder/send adapters before enabling dispatch'},...(i.binary?{binary:i.binary}:{})}));",
        "mode": "runOnceForAllItems"
      }
