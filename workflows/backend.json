        "jsCode": "\nreturn [{json:{tenant_id:'northstar_demo',id:'manual-forward-'+$execution.id,source:'forwarded_email',channel:'email_forward',direction:'inbound',external:true,synthetic:true,body:'Could you send plan prices and explain the Enterprise SLA?',occurred_at:new Date().toISOString()}}];",
